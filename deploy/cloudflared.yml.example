# /etc/cloudflared/config.yml on the Pi. `make deploy-tunnel` renders this
# file, replacing TUNNEL_ID and TUNNEL_HOST. To fill it in by hand, use the
# tunnel's UUID (from `cloudflared tunnel list` on the Mac) and the public
# hostname, e.g. anova.example.com.
tunnel: TUNNEL_ID
credentials-file: /etc/cloudflared/TUNNEL_ID.json

ingress:
  # REST API, SSE, /mcp, /.well-known/oauth-protected-resource and /health.
  # The cooker port (8080) is raw TCP and stays on the router forward.
  - hostname: TUNNEL_HOST
    service: http://localhost:8000
  - service: http_status:404
