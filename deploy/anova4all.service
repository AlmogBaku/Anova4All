# Install: sudo cp deploy/anova4all.service /etc/systemd/system/ && sudo systemctl daemon-reload
# The env file holds DATABASE_URL and the rest of the config; keep it mode 600.
[Unit]
Description=Anova4All server
After=network-online.target
Wants=network-online.target

[Service]
User=anova4all
WorkingDirectory=/opt/anova4all
EnvironmentFile=/opt/anova4all/anova4all.env
ExecStart=/opt/anova4all/anova4all
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/anova4all
PrivateTmp=true

[Install]
WantedBy=multi-user.target
