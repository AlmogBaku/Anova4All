# Install: sudo cp deploy/anova4all.service /etc/systemd/system/ && sudo systemctl daemon-reload
# The env file holds DATABASE_URL and the rest of the config; keep it mode 600.
# The binary and env file are owned by the deploy user, not anova4all: the
# service writes nothing to disk.
[Unit]
Description=Anova4All server
After=network-online.target
Wants=network-online.target

[Service]
User=anova4all
WorkingDirectory=/opt/anova4all
EnvironmentFile=/opt/anova4all/anova4all.env
ExecStart=/opt/anova4all/anova4all
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
# If the TLS cert and key live under /home, set ProtectHome=read-only.
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
