# Settings for `docker compose`. Copy to .env and fill in. Placeholder values only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# Postgres URL for the anova_server role. TLS must be verify-full: download your
# project's CA from the Supabase dashboard into ./certs (mounted at /certs).
DATABASE_URL=postgresql://anova_server.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=/certs/prod-ca-2021.crt
# The address the cooker dials on port 8080 (a public IP, a DNS name or a LAN IP).
PUBLIC_HOST=
# Optional: the public MCP endpoint, e.g. https://anova.example.com/mcp
MCP_PUBLIC_URL=
